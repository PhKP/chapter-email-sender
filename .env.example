# Resend API key — create one at https://resend.com (Sending access only)
RESEND_API_KEY=re_...

# Sender address — must be on a domain verified in your Resend account
SENDER_EMAIL=noreply@mail.yourdomain.com

# Display name shown in the From field
SENDER_NAME="97 Things Every Software Architect Should Know"

# Book title shown in the email header and footer
BOOK_TITLE="97 Things Every Software Architect Should Know"

# Address to deliver chapters to
RECIPIENT=you@example.com

# Timezone for the cron schedule (used by Docker)
TZ=Europe/Copenhagen

# Cron schedule for sending chapters — Docker only (default: 07:00 on weekdays)
CRON_SCHEDULE="0 7 * * 1-5"
